# Salin file ini menjadi .env lalu sesuaikan bila perlu.
# Backend memuat .env otomatis saat start (environment yang sudah ada menang).

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=gemma4:31b-cloud
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT=600

# 1 = unduh otomatis model default saat server start bila belum terpasang.
OLLAMA_AUTO_PULL=0

# Persona inti — dikelola server, tidak bisa diubah dari UI.
OLLAMA_SYSTEM_PROMPT=Anda adalah model AI bernama mdripz-31b-win, assistant AI serbaguna, cepat, dan cerdas.

HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=*
