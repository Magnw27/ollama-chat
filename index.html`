<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>NEON AI | Memory Edition</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: #020617;
            color: #f8fafc;
            margin: 0;
            padding: 0;
            overflow: hidden;
            height: 100vh;
        }
        .mono { font-family: 'JetBrains Mono', monospace; }
        .glass-panel {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 10px; }
        .typing-cursor::after {
            content: '|';
            animation: blink 1s step-end infinite;
        }
        @keyframes blink { 50% { opacity: 0; } }
        .bg-glow {
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.15;
            z-index: 0;
            pointer-events: none;
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef } = React;

        function App() {
            // Load chat history from localStorage on startup
            const [messages, setMessages] = useState(() => {
                const saved = localStorage.getItem('neon_ai_history');
                return saved ? JSON.parse(saved) : [];
            });
            const [input, setInput] = useState('');
            const [isLoading, setIsLoading] = useState(false);
            const [displayTexts, setDisplayTexts] = useState({});
            const messagesEndRef = useRef(null);

            // Save history to localStorage whenever messages change
            useEffect(() => {
                localStorage.setItem('neon_ai_history', JSON.stringify(messages));
            }, [messages]);

            const scrollToBottom = () => {
                messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
            };

            useEffect(() => { scrollToBottom(); }, [messages, displayTexts]);

            useEffect(() => {
                const lastMsg = messages[messages.length - 1];
                if (lastMsg && lastMsg.role === 'ai') {
                    let currentText = "";
                    let index = 0;
                    const text = lastMsg.text;
                    const msgId = messages.length - 1;

                    const interval = setInterval(() => {
                        currentText += text[index];
                        setDisplayTexts(prev => ({ ...prev, [msgId]: currentText }));
                        index++;
                        if (index >= text.length) clearInterval(interval);
                    }, 20);
                    return () => clearInterval(interval);
                }
            }, [messages]);

            const handleSend = async () => {
                if (!input.trim()) return;

                const userMsg = { role: 'user', text: input };

                // Maintain only the last 100 messages for memory
                const history = [...messages, userMsg].slice(-100);
                setMessages(history);
                setInput('');
                setIsLoading(true);

                // Format messages for the backend API (role and content)
                const apiMessages = history.map(m => ({
                    role: m.role,
                    content: m.text
                }));

                try {
                    const response = await fetch('/chat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ messages: apiMessages })
                    });
                    const data = await response.json();

                    const aiMsg = {
                        role: 'ai',
                        text: data.response || 'System Error: Neural link severed.'
                    };
                    setMessages(prev => [...prev, aiMsg].slice(-100));
                } catch (error) {
                    setMessages(prev => [...prev, { role: 'ai', text: 'CRITICAL ERROR: Connection lost.' }]);
                } finally {
                    setIsLoading(false);
                }
            };

            const clearHistory = () => {
                if(confirm("Hapus semua riwayat chat?")) {
                    setMessages([]);
                    localStorage.removeItem('neon_ai_history');
                }
            };

            return (
                <div className="h-screen w-full flex flex-col relative overflow-hidden bg-[#020617]">
                    <div className="bg-glow bg-blue-600 top-[-10%] left-[-10%]"></div>
                    <div className="bg-glow bg-purple-600 bottom-[-10%] right-[-10%]"></div>

                    <div className="flex-1 flex flex-col w-full max-w-4xl mx-auto h-full relative z-10">
                        <header className="p-4 border-b border-white/10 flex justify-between items-center bg-white/5 backdrop-blur-md">
                            <div className="flex items-center gap-3">
                                <div className="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-lg flex items-center justify-center shadow-md">
                                    <span className="text-white font-bold text-sm">G</span>
                                </div>
                                <h1 className="text-lg font-bold tracking-tight text-white">
                                    NEON <span className="text-blue-400">AI</span> <span className="text-[10px] ml-1 text-gray-500 mono uppercase">Memory v1</span>
                                </h1>
                            </div>
                            <div className="flex items-center gap-3">
                                <button onClick={clearHistory} className="text-[10px] text-gray-500 hover:text-red-400 transition-colors mono uppercase">Clear</button>
                                <div className="flex items-center gap-2 bg-black/30 px-2 py-1 rounded-full border border-white/10">
                                    <span className="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span>
                                    <span className="text-[10px] text-gray-300 mono uppercase">Core_On</span>
                                </div>
                            </div>
                        </header>

                        <div className="flex-1 overflow-y-auto p-4 space-y-4 custom-scrollbar">
                            {messages.length === 0 && (
                                <div className="h-full flex flex-col items-center justify-center text-center p-6">
                                    <div className="p-6 bg-white/5 rounded-2xl border border-white/10 backdrop-blur-sm">
                                        <h2 className="text-xl font-bold mb-2 text-blue-400">Ready for Query</h2>
                                        <p className="text-gray-400 text-sm max-w-xs mx-auto">Gemma-4 local core active. I now remember our previous conversations!</p>
                                    </div>
                                </div>
                            )}

                            {messages.map((msg, i) => (
                                <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                                    <div className={`max-w-[85%] p-3 rounded-2xl shadow-sm ${
                                        msg.role === 'user'
                                        ? 'bg-blue-600 text-white rounded-tr-none'
                                        : 'bg-slate-900/80 text-gray-200 rounded-tl-none border border-white/10'
                                    }`}>
                                        <div className="flex items-center gap-2 mb-1 opacity-40 text-[9px] mono uppercase">
                                            {msg.role === 'user' ? 'User' : 'Gemma'}
                                        </div>
                                        <p className={`text-sm leading-relaxed ${msg.role === 'ai' ? 'mono' : ''}`}>
                                            {msg.role === 'ai' ? (displayTexts[i] || "") : msg.text}
                                            {msg.role === 'ai' && displayTexts[i]?.length < msg.text.length && <span className="typing-cursor"></span>}
                                        </p>
                                    </div>
                                </div>
                            ))}

                            {isLoading && (
                                <div className="flex justify-start">
                                    <div className="bg-slate-900/80 p-3 rounded-2xl rounded-tl-none border border-white/10">
                                        <div className="flex gap-1">
                                            <div className="w-1 h-1 bg-blue-400 rounded-full animate-bounce"></div>
                                            <div className="w-1 h-1 bg-purple-400 rounded-full animate-bounce [animation-delay:0.2s]"></div>
                                            <div className="w-1 h-1 bg-pink-400 rounded-full animate-bounce [animation-delay:0.4s]"></div>
                                        </div>
                                    </div>
                                </div>
                            )}
                            <div ref={messagesEndRef} />
                        </div>

                        <div className="p-4 bg-white/5 border-t border-white/10">
                            <div className="relative flex items-center gap-2 max-w-4xl mx-auto">
                                <input
                                    type="text"
                                    value={input}
                                    onChange={(e) => setInput(e.target.value)}
                                    onKeyPress={(e) => e.key === 'Enter' && handleSend()}
                                    placeholder="Ask something..."
                                    className="flex-1 p-3 bg-slate-950 border border-white/10 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/50 transition-all text-white placeholder-gray-600 mono text-sm"
                                />
                                <button
                                    onClick={handleSend}
                                    disabled={isLoading}
                                    className="p-3 bg-blue-600 hover:bg-blue-500 text-white rounded-xl shadow-md transition-colors disabled:opacity-50"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" strokeWidth={2} stroke="currentColor" className="w-5 h-5">
                                        <path strokeLinecap="round" strokeLinejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
